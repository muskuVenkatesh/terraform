# Local Terraform directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Sensitive / environment-specific tfvars (if any)
*.secret.tfvars
secrets.tfvars

# Generated practice outputs created during local terraform apply
generated_logs/
generated_users/
generated_configs/

# OS generated files
.DS_Store
