# Local .terraform directories
.terraform/
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform workspace state directory
terraform.tfstate.d/

# Crash log files
crash.log
crash.*.log

# Terraform plan files
*.tfplan

# Variable files containing sensitive values
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Generated output files from local_file resource
dev.txt
staging.txt
prod.txt

# OS metadata
.DS_Store
Thumbs.db
